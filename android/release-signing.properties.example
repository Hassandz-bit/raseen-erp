# انسخ هذا الملف باسم release-signing.properties ولا تضعه في Git أو في ملف تسليم عام.
# ضع ملف JKS خارج مجلد المشروع أو في خدمة أسرار مؤسسية محمية.
storeFile=../secure/raseen-release.jks
